{
  "format_version": "2025.1",
  "package": {
    "name": "dash-utils",
    "version": "1.0.0",
    "description": "Shell utilities toolkit - Pure dash scripts, NO Python!",
    "homepage": "https://github.com/provide-io/flavorpack",
    "tags": ["shell", "dash", "posix", "non-python"]
  },
  "execution": {
    "command": "{workenv}/bin/dash",
    "args": ["{workenv}/scripts/dash-utils.sh"],
    "env": {
      "unset": ["*"],
      "pass": ["PATH", "HOME", "USER", "TERM", "LANG", "LC_*"]
    }
  },
  "slots": [
    {
      "id": 0,
      "purpose": "runtime",
      "path": "bin/dash",
      "extract_to": "{workenv}/bin/dash",
      "lifecycle": "cached",
      "operations": ["gzip"],
      "permissions": "0755"
    },
    {
      "id": 1,
      "purpose": "code",
      "path": ".",
      "extract_to": "{workenv}/scripts",
      "lifecycle": "cached",
      "operations": ["tar", "gzip"],
      "permissions": "0755",
      "include": [
        "dash-utils.sh",
        "utils/*.sh"
      ],
      "exclude": [
        "bin/",
        "*.md",
        "*.toml",
        "*.json",
        "*.py"
      ]
    }
  ],
  "signing": {
    "deterministic": true,
    "key_seed": "dash-utils-v1-json"
  },
  "build": {
    "compression": "gzip",
    "compression_level": 6,
    "strip_binaries": false
  }
}
