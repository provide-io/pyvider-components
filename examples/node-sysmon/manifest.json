{
  "format_version": "2025.1",
  "package": {
    "name": "node-sysmon",
    "version": "1.0.0",
    "description": "Node.js System Monitor - Pure JavaScript, NO Python!",
    "homepage": "https://github.com/provide-io/flavorpack",
    "tags": ["nodejs", "javascript", "system-monitor", "non-python"]
  },
  "execution": {
    "comment": "Execute with Node.js runtime - NO Python involved!",
    "command": "{workenv}/bin/node",
    "args": ["{workenv}/app/sysmon.js"],
    "env": {
      "unset": ["*"],
      "pass": ["PATH", "HOME", "USER", "TERM", "LANG", "LC_*", "NODE_*"]
    }
  },
  "slots": [
    {
      "id": 0,
      "purpose": "runtime",
      "comment": "Node.js binary (the JavaScript runtime)",
      "path": "bin/node",
      "extract_to": "{workenv}/bin/node",
      "lifecycle": "cached",
      "operations": ["gzip"],
      "permissions": "0755"
    },
    {
      "id": 1,
      "purpose": "code",
      "comment": "JavaScript application code",
      "path": ".",
      "extract_to": "{workenv}/app",
      "lifecycle": "cached",
      "operations": ["tar", "gzip"],
      "permissions": "0755",
      "include": [
        "sysmon.js",
        "package.json"
      ],
      "exclude": [
        "bin/",
        "*.md",
        "manifest.json",
        "pyproject.toml"
      ]
    }
  ],
  "signing": {
    "deterministic": true,
    "key_seed": "node-sysmon-v1-json"
  },
  "build": {
    "compression": "gzip",
    "compression_level": 6,
    "strip_binaries": false
  }
}
