#!/bin/bash
# Pyvider Terraform Provider Wrapper Script
set -eo pipefail

# 🤝 This is the handshake fix.
# Terraform provides the cookie in TF_PLUGIN_MAGIC_COOKIE.
# The pyvider-rpcplugin library expects to find this same value in
# PLUGIN_MAGIC_COOKIE_VALUE to validate the handshake.
# We export it here to ensure it's set before the Python process starts.
export PLUGIN_MAGIC_COOKIE_VALUE="${TF_PLUGIN_MAGIC_COOKIE}"

# --- Optional Debug Logging to STDERR ---
# To enable, uncomment the following lines.
# log_debug() {
#   echo -e "🐛 [provider script] $1" >&2
# }
# log_debug "TF_PLUGIN_MAGIC_COOKIE      = '${TF_PLUGIN_MAGIC_COOKIE}'"
# log_debug "PLUGIN_MAGIC_COOKIE_VALUE = '${PLUGIN_MAGIC_COOKIE_VALUE}'"
# log_debug "Executing Python provider: /Users/tim/code/pyv/mono/pyvider-rpcplugin/.venv_darwin_arm64/bin/python3 -m pyvider $@"

# Execute the pyvider module using the Python executable that ran the CLI.
exec "python3" -m pyvider "$@"
