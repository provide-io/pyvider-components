{
  "monitoring": {
    "environment": "${environment}",
    "application": "${application_name}",
    "level": "${monitoring_level}",

    "token_monitoring": {
      "primary_application": {
        "token_id": "${app_primary_id}",
        "token_name": "${app_primary_name}",
        "expires_at": "${app_primary_expires}",
        "criticality": "high",
        "alert_thresholds": {
          "expiry_warning_minutes": ${expiry_warning_minutes},
          "usage_anomaly_threshold": 2.0
        }
      },

      "backup_tokens": ${jsonencode(backup_tokens_monitoring)},

      "infrastructure_tokens": [
        {
          "service": "database_readonly",
          "token_id": "${database_read_id}",
          "token_name": "${database_read_name}",
          "expires_at": "${database_read_expires}",
          "criticality": "high"
        },
        {
          "service": "api_gateway",
          "token_id": "${api_gateway_id}",
          "token_name": "${api_gateway_name}",
          "expires_at": "${api_gateway_expires}",
          "criticality": "high"
        },
        {
          "service": "internal_apis",
          "token_id": "${api_internal_id}",
          "token_name": "${api_internal_name}",
          "expires_at": "${api_internal_expires}",
          "criticality": "medium"
        }
      ],

      "observability_tokens": [
        {
          "service": "metrics_collection",
          "token_id": "${metrics_collector_id}",
          "token_name": "${metrics_collector_name}",
          "expires_at": "${metrics_collector_expires}",
          "criticality": "medium"
        },
        {
          "service": "log_aggregation",
          "token_id": "${log_aggregator_id}",
          "token_name": "${log_aggregator_name}",
          "expires_at": "${log_aggregator_expires}",
          "criticality": "medium"
        }
      ]
    },

    "alert_configuration": {
      "channels": ${jsonencode(alert_channels)},
      "escalation_policy": {
        "immediate": ${immediate_escalation},
        "business_hours_only": ${business_hours_only},
        "weekend_alerts": ${weekend_alerts}
      },
      "notification_templates": {
        "token_expiry": "Token $${token_name} ($${token_id}) expires at $${expires_at}",
        "token_rotation": "Token rotation required for ${environment} environment",
        "token_failure": "Token authentication failed for service $${service_name}"
      }
    },

    "health_checks": {
      "enabled": true,
      "interval_seconds": ${health_check_interval},
      "timeout_seconds": 10,
      "failure_threshold": ${health_check_threshold},

      "endpoints": [
        {
          "name": "token_validation",
          "url": "${token_validation_url}",
          "method": "POST",
          "expected_status": 200
        },
        {
          "name": "api_gateway_health",
          "url": "${api_health_url}",
          "method": "GET",
          "expected_status": 200
        }
      ]
    }
  },

  "compliance": {
    "audit_logging": ${audit_logging},
    "token_lifecycle_tracking": true,
    "access_review_required": ${access_review_required},
    "encryption_at_rest": true,
    "encryption_in_transit": true
  }
}
