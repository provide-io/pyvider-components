{
  "environment": "${environment}",
  "application": "${application_name}",
  "timestamp": "${timestamp}",
  "configuration": ${jsonencode(current_config)},
  "tokens": {
    "application": {
      "primary": {
        "name": "${app_primary_name}",
        "id": "${app_primary_id}",
        "expires_at": "${app_primary_expires}",
        "type": "primary"
      },
      "backups": ${jsonencode(app_backup_tokens)}
    },
    "database": {
      "readonly": {
        "name": "${database_read_name}",
        "id": "${database_read_id}",
        "expires_at": "${database_read_expires}",
        "permissions": ["read", "list"]
      },
      "readwrite": ${database_write_config}
    },
    "api_services": {
      "gateway": {
        "name": "${api_gateway_name}",
        "id": "${api_gateway_id}",
        "expires_at": "${api_gateway_expires}",
        "scope": "external"
      },
      "internal": {
        "name": "${api_internal_name}",
        "id": "${api_internal_id}",
        "expires_at": "${api_internal_expires}",
        "scope": "internal"
      }
    },
    "observability": {
      "metrics": {
        "name": "${metrics_collector_name}",
        "id": "${metrics_collector_id}",
        "expires_at": "${metrics_collector_expires}",
        "service": "prometheus"
      },
      "logs": {
        "name": "${log_aggregator_name}",
        "id": "${log_aggregator_id}",
        "expires_at": "${log_aggregator_expires}",
        "service": "elasticsearch"
      },
      "traces": ${trace_collector_config}
    }
  },
  "security_policy": {
    "rotation_required": ${rotation_required},
    "monitoring_level": "${monitoring_level}",
    "backup_strategy": "multiple_tokens",
    "alert_channels": ${jsonencode(alert_channels)}
  },
  "compliance": {
    "environment_isolation": true,
    "token_segregation": true,
    "principle_of_least_privilege": true,
    "automatic_expiration": true
  }
}
